{
  "name": "devprofile-vscode",
  "displayName": "DevProfile Tracker",
  "description": "DevProfile companion extension: tracks coding sessions, time per problem, and pomodoros",
  "version": "1.0.0",
  "publisher": "devprofile-team",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "devprofile.startProblem",
        "title": "DevProfile: Start Problem"
      },
      {
        "command": "devprofile.markSolved",
        "title": "DevProfile: Mark Solved"
      },
      {
        "command": "devprofile.logSession",
        "title": "DevProfile: Log Session"
      },
      {
        "command": "devprofile.openDashboard",
        "title": "DevProfile: Open Dashboard"
      },
      {
        "command": "devprofile.togglePomodoro",
        "title": "DevProfile: Pomodoro Start/Stop"
      },
      {
        "command": "devprofile.toggleTracking",
        "title": "DevProfile: Toggle Tracking"
      }
    ],
    "configuration": {
      "title": "DevProfile",
      "properties": {
        "devprofile.apiKey": {
          "type": "string",
          "default": "",
          "description": "Your DevProfile Personal API Key"
        },
        "devprofile.apiUrl": {
          "type": "string",
          "default": "http://localhost:5000",
          "description": "DevProfile Backend API URL"
        },
        "devprofile.trackFileNames": {
          "type": "boolean",
          "default": false,
          "description": "Track relative file names (off by default: sends only file extension)"
        },
        "devprofile.ignoredProjects": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": ["node_modules", ".git", "dist", "build", "vendor"],
          "description": "List of project names or patterns to ignore"
        },
        "devprofile.idleMinutes": {
          "type": "number",
          "default": 2,
          "description": "Idle duration in minutes to end active coding session"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.4.5"
  }
}
